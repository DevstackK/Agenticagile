# Required for the AI helper ("Suggest" button) and the Requirements Draft feature.
# Get a key at https://console.anthropic.com/settings/keys
# Set this as a Vercel project environment variable — never commit a real value here.
ANTHROPIC_API_KEY=

# Required for the Stage Gate's "Generate Executive Deck" action.
# Get a key at https://developers.gamma.app
GAMMA_API_KEY=

# Required for the Stage Gate's "Send to Exec" action.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
